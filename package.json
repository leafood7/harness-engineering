{
  "name": "harness-engineering",
  "version": "0.13.0",
  "private": true,
  "type": "module",
  "bin": {
    "harness": "bin/harness.mjs"
  },
  "scripts": {
    "harness": "node bin/harness.mjs",
    "check": "tsc --noEmit",
    "test": "node --test --test-concurrency=1 tests/*.test.ts",
    "demo": "node bin/harness.mjs demo",
    "verify:runtime": "node --import ../pi/packages/coding-agent/src/experimental/source-resolver.ts scripts/verify-runtime.mjs",
    "demo:recovery": "node examples/recovery-demo.ts",
    "demo:context": "node examples/context-memory-demo.ts",
    "benchmark:plan": "node bin/harness.mjs benchmark plan benchmarks/deepseek-flash.json",
    "benchmark:live": "node bin/harness.mjs benchmark run benchmarks/deepseek-flash.json",
    "benchmark:smoke": "node bin/harness.mjs benchmark run benchmarks/offline-smoke.json",
    "benchmark:strategies": "node bin/harness.mjs benchmark run benchmarks/strategy-comparison.json",
    "benchmark:strategy-smoke": "node bin/harness.mjs benchmark run benchmarks/strategy-smoke.json",
    "benchmark:read-correction": "node bin/harness.mjs benchmark run benchmarks/read-correction-comparison.json",
    "benchmark:read-correction-smoke": "node bin/harness.mjs benchmark run benchmarks/read-correction-smoke.json",
    "demo:queue": "node examples/queue-demo.ts",
    "dashboard": "node bin/harness.mjs dashboard"
  },
  "engines": {
    "node": ">=24.22.1"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@earendil-works/pi-ai": "1.4.0",
    "typebox": "1.3.27"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "typescript": "7.0.2"
  }
}
